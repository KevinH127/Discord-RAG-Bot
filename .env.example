POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag

# Embeddings (Ollama). EMBED_DIM must match the model and the vector(N) column.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "

# Answer generation (Ollama)
LLM_MODEL=gemma4:e2b
LLM_TEMPERATURE=0
LLM_NUM_CTX=16384
# Thinking models only (e.g. qwen3): true/false, or low/medium/high where supported.
# false works with every model; true errors on models that can't think.
LLM_THINK=false

# Question rewriting (LLM call 1). VERIFIER_MODEL defaults to LLM_MODEL if unset.
VERIFIER_MODEL=gemma4:e2b
VERIFIER_THINK=false
